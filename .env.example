# Local-only backend configuration.
# Copy this file to .env.local before starting docker compose.

APP_NAME=rag-role-enterprise-api
ENV=dev

# Browser/API integration
CORS_ORIGINS=http://localhost:8083,http://127.0.0.1:8083,http://localhost:5173,http://127.0.0.1:5173
GMAIL_REDIRECT_URI=http://localhost:8083/gmail/callback

# Local containers; do not replace these hosts with production addresses.
DATABASE_URL=mysql+pymysql://rag:rag@mysql:3306/ragdb?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
OPENFGA_URL=http://openfga:8080
OPENFGA_STORE_NAME=rag-enterprise-local
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=
OPENFGA_CONFIG_FILE=/run/openfga/config.json

# Local authentication secret. Replace for any shared environment.
JWT_SECRET_KEY=local-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_BUCKET_RAW=raw
MINIO_BUCKET_PROCESSED=processed

# ChromaDB
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_PATH=/data/chroma
CHROMA_COLLECTION=document_chunks
EMBEDDING_DIMS=1536

# LLM. Use a real local key only when OpenAI is selected.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMS=1536

# Optional Ollama running on the host machine.
OLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=http://host.docker.internal:11434
OLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

LLM_TIMEOUT_SECONDS=300
MAX_UPLOAD_SIZE_MB=50
DEFAULT_POLICY_VERSION=v1
GLINER_MODEL_NAME=urchade/gliner_multi-v2.1
GLINER_THRESHOLD=0.3

# Ontology graph (Neo4j) — the "Cấu hình thực thể > Xem đồ thị" visualization.
# This is what the Python code reads to connect. The neo4j container's own
# real password is a SEPARATE setting, NEO4J_PASSWORD in back-end/.env
# (the file Docker Compose itself reads for docker-compose.yml's ${}
# substitution — not this one). Set the SAME value in both places, or the
# api container won't be able to log into Neo4j. Also: changing this after
# neo4j's data volume already exists only changes what this app *expects*
# — it does NOT change the password already stored inside Neo4j. Either
# rotate it before the volume is first created, or also update it inside
# Neo4j itself (cypher-shell / Neo4j Browser) when rotating in production.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ontology12345
